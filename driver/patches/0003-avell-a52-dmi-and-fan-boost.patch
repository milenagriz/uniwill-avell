+/*
+ * Fan boost ("full fan mode"): bit 6 of EC_ADDR_MANUAL_FAN_CTRL makes the EC
+ * run all fans at full speed; clearing it hands control back to the EC's own
+ * fan curve. There is a single bit for both fans, so pwm1/pwm2 share a mode.
+ *
+ * pwmN_enable follows the hwmon ABI:
+ *   0 - no fan speed control, i.e. full speed (boost on)
+ *   1 - manual: like gpd-fan, entering manual mode starts at full speed
+ *       (boost on). Only pwmN = 255 is accepted, the EC offers no
+ *       intermediate manual speeds through this interface
+ *   2 - automatic (EC fan curve, boost off)
+ *
+ * The EC is the source of truth: if boost is found off (e.g. a hotkey or the
+ * firmware cleared it), the mode reads as automatic, never as manual.
+ */
+#define UNIWILL_PWM_MODE_FULL	0
+#define UNIWILL_PWM_MODE_MANUAL	1
+#define UNIWILL_PWM_MODE_AUTO	2
+
+static int uniwill_set_fan_boost(struct uniwill_data *data, bool enable)
+{
+	int ret;
+
+	ret = regmap_update_bits(data->regmap, EC_ADDR_MANUAL_FAN_CTRL, FAN_MODE_BOOST,
+				 enable ? FAN_MODE_BOOST : 0);
+	if (ret < 0)
+		return ret;
+
+	data->fan_boost = enable;
 
 	return 0;
 }
 
+static int uniwill_write(struct device *dev, enum hwmon_sensor_types type, u32 attr, int channel,
+			 long val)
+{
+	struct uniwill_data *data = dev_get_drvdata(dev);
+
+	if (type != hwmon_pwm || !uniwill_device_supports(data, UNIWILL_FEATURE_FAN_BOOST))
+		return -EOPNOTSUPP;
+
+	guard(mutex)(&data->fan_boost_lock);
+
+	switch (attr) {
+	case hwmon_pwm_enable:
+		switch (val) {
+		case UNIWILL_PWM_MODE_FULL:
+			data->pwm_mode = val;
+			return uniwill_set_fan_boost(data, true);
+		case UNIWILL_PWM_MODE_MANUAL:
+			data->pwm_mode = val;
+			return uniwill_set_fan_boost(data, true);
+		case UNIWILL_PWM_MODE_AUTO:
+			data->pwm_mode = val;
+			return uniwill_set_fan_boost(data, false);
+		default:
+			return -EINVAL;
+		}
+	case hwmon_pwm_input:
+		if (data->pwm_mode != UNIWILL_PWM_MODE_MANUAL)
+			return -EBUSY;
+
+		if (val != U8_MAX)
+			return -EINVAL;
+
+		return uniwill_set_fan_boost(data, true);
+	default:
+		return -EOPNOTSUPP;
+	}
+}
