+static int uniwill_suspend_direct_fan(struct uniwill_data *data)
+{
+	int ret;
+
+	if (!uniwill_device_supports(data, UNIWILL_FEATURE_DIRECT_FAN))
+		return 0;
+
+	/* Nobody updates the duty while suspended: hand the fans back to the firmware */
+	scoped_guard(mutex, &data->fan_boost_lock) {
+		ret = uniwill_fan_leave_manual(data);
+		if (ret < 0)
+			return ret;
+	}
+
+	cancel_delayed_work_sync(&data->fan_watchdog);
+
+	return 0;
+}
