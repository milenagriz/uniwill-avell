+static int uniwill_suspend_power_profile(struct uniwill_data *data)
+{
+	unsigned int value;
+	int ret;
+
+	if (!uniwill_device_supports(data, UNIWILL_FEATURE_POWER_PROFILE))
+		return 0;
+
+	/* EC_ADDR_MANUAL_FAN_CTRL is volatile, so remember the mode ourselves */
+	ret = regmap_read(data->regmap, EC_ADDR_MANUAL_FAN_CTRL, &value);
+	if (ret < 0)
+		return ret;
+
+	data->power_profile_bits = value & POWER_PROFILE_MASK;
+
+	return 0;
+}
