+/*
+ * Power profile: bits 4, 5 and 7 of EC_ADDR_MANUAL_FAN_CTRL select the
+ * firmware's operating mode (quiet 0xa0, balanced 0x00, performance 0x10).
+ * Bit 6 in the same register is Max fan, so all read-modify-write cycles on
+ * this register take fan_boost_lock. The EC does not change the mode on its
+ * own; the performance key only reports UNIWILL_OSD_PERFORMANCE_MODE_TOGGLE,
+ * which cycles the profile in the kernel.
+ */
+#define POWER_PROFILE_MASK		(FAN_MODE_USER | FAN_MODE_HIGH | FAN_MODE_TURBO)
+#define POWER_PROFILE_QUIET		(FAN_MODE_USER | FAN_MODE_HIGH)
+#define POWER_PROFILE_BALANCED		0x00
+#define POWER_PROFILE_PERFORMANCE	FAN_MODE_TURBO
+
+static int uniwill_power_profile_probe(void *drvdata, unsigned long *choices)
+{
+	set_bit(PLATFORM_PROFILE_QUIET, choices);
+	set_bit(PLATFORM_PROFILE_BALANCED, choices);
+	set_bit(PLATFORM_PROFILE_PERFORMANCE, choices);
+
+	return 0;
+}
+
+static int uniwill_power_profile_get(struct device *dev, enum platform_profile_option *profile)
+{
+	struct uniwill_data *data = dev_get_drvdata(dev);
+	unsigned int value;
+	int ret;
+
+	ret = regmap_read(data->regmap, EC_ADDR_MANUAL_FAN_CTRL, &value);
+	if (ret < 0)
+		return ret;
+
+	switch (value & POWER_PROFILE_MASK) {
+	case POWER_PROFILE_QUIET:
+		*profile = PLATFORM_PROFILE_QUIET;
+		break;
+	case POWER_PROFILE_BALANCED:
+		*profile = PLATFORM_PROFILE_BALANCED;
+		break;
+	case POWER_PROFILE_PERFORMANCE:
+		*profile = PLATFORM_PROFILE_PERFORMANCE;
+		break;
+	default:
+		*profile = PLATFORM_PROFILE_CUSTOM;
+		break;
+	}
+
+	return 0;
+}
+
+static int uniwill_write_power_profile_bits(struct uniwill_data *data, unsigned int bits)
+{
+	guard(mutex)(&data->fan_boost_lock);
+
+	return regmap_update_bits(data->regmap, EC_ADDR_MANUAL_FAN_CTRL, POWER_PROFILE_MASK, bits);
+}
+
+static int uniwill_power_profile_set(struct device *dev, enum platform_profile_option profile)
+{
+	struct uniwill_data *data = dev_get_drvdata(dev);
+
+	switch (profile) {
+	case PLATFORM_PROFILE_QUIET:
+		return uniwill_write_power_profile_bits(data, POWER_PROFILE_QUIET);
+	case PLATFORM_PROFILE_BALANCED:
+		return uniwill_write_power_profile_bits(data, POWER_PROFILE_BALANCED);
+	case PLATFORM_PROFILE_PERFORMANCE:
+		return uniwill_write_power_profile_bits(data, POWER_PROFILE_PERFORMANCE);
+	default:
+		return -EOPNOTSUPP;
+	}
+}
+
+static const struct platform_profile_ops uniwill_power_profile_ops = {
+	.probe = uniwill_power_profile_probe,
+	.profile_get = uniwill_power_profile_get,
+	.profile_set = uniwill_power_profile_set,
+};
+
+static void uniwill_restore_power_profile(void *context)
+{
+	struct uniwill_data *data = context;
+
+	uniwill_write_power_profile_bits(data, data->power_profile_initial);
+}
+
+static int uniwill_power_profile_init(struct uniwill_data *data)
+{
+	unsigned int value;
+	int ret;
+
+	if (!uniwill_device_supports(data, UNIWILL_FEATURE_POWER_PROFILE))
+		return 0;
+
+	ret = regmap_read(data->regmap, EC_ADDR_MANUAL_FAN_CTRL, &value);
+	if (ret < 0)
+		return ret;
+
+	/* Hand the firmware back the mode it booted with */
+	data->power_profile_initial = value & POWER_PROFILE_MASK;
+	ret = devm_add_action_or_reset(data->dev, uniwill_restore_power_profile, data);
+	if (ret < 0)
+		return ret;
+
+	data->ppdev = devm_platform_profile_register(data->dev, "uniwill", data,
+						     &uniwill_power_profile_ops);
+
+	return PTR_ERR_OR_ZERO(data->ppdev);
+}
