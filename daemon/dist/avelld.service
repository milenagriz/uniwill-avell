[Unit]
Description=Avell A52 MOB control daemon
Documentation=https://github.com/milenagriz5-dotcom/uniwill-avell
# No After= on power-profiles-daemon: it orders itself after multi-user.target, so ordering avelld
# (WantedBy=multi-user.target) after it is a cycle. avelld reaches it on each call, so a late start is fine.
Wants=power-profiles-daemon.service

[Service]
Type=dbus
BusName=org.avell.Control1
ExecStart=/usr/local/bin/avelld
Restart=on-failure

[Install]
WantedBy=multi-user.target
